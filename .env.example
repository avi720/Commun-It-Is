# =====================================================================
# Frontend (Vite) — חייבים קידומת VITE_ כדי שיהיו זמינים בבנייה
# =====================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-supabase-anon-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# אופציונלי: כתובת ה-API. אם לא מוגדר, ברירת המחדל היא "/api"
# (עובד כשה-backend מתארח באותו פרויקט Vercel).
# VITE_API_URL=https://your-deployment.vercel.app/api

# =====================================================================
# Backend (FastAPI / Python serverless) — משתני runtime
# =====================================================================
# VITE_SUPABASE_URL משמש גם את ה-backend (אותו ערך כמו למעלה)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# מפתח Firebase Admin כ-JSON במחרוזת אחת (service account)
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}
# רשימת origins מותרים ל-CORS (CSV). בפרוד הגדר את ה-URL הציבורי.
# ברירת מחדל אם לא מוגדר: http://localhost:5173 (עבור פיתוח מקומי).
ALLOWED_ORIGINS=https://your-deployment.vercel.app

# =====================================================================
# Sentry error tracking (T19)
# =====================================================================
# ה-DSN הוא public ולא סוד; הוא נכנס ל-bundle של ה-frontend ממילא. ההגנה היא
# שרק הפרויקט שלך מקבל אירועים אליו. אל תשתף DSNs בין פרויקטים.
# קבל אותם מ-https://avior-0b.sentry.io → Project Settings → Client Keys (DSN).
#
# בלי DSN — Sentry פשוט שקט (init לא נקרא). זה בסדר ל-dev ול-CI.
VITE_SENTRY_DSN=https://...@o....ingest.de.sentry.io/...
SENTRY_DSN=https://...@o....ingest.de.sentry.io/...
# אופציונלי: מזהה גרסה לכל deploy. ב-Vercel הוא ייקבע אוטומטית ל-git SHA.
# VITE_RELEASE=dev
