# =====================================================================
# Frontend (Vite) — חייבים קידומת VITE_ כדי שיהיו זמינים בבנייה
# =====================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-supabase-anon-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# אופציונלי: כתובת ה-API. אם לא מוגדר, ברירת המחדל היא "/api"
# (עובד כשה-backend מתארח באותו פרויקט Vercel).
# VITE_API_URL=https://your-deployment.vercel.app/api

# =====================================================================
# Backend (FastAPI / Python serverless) — משתני runtime
# =====================================================================
# VITE_SUPABASE_URL משמש גם את ה-backend (אותו ערך כמו למעלה)
VITE_SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# מפתח Firebase Admin כ-JSON במחרוזת אחת (service account)
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}
